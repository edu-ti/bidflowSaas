# Backend environment – LOCAL development
DB_URL=postgres://postgres:postgres@localhost:5432/bidflow?sslmode=disable
REDIS_ADDR=localhost:6379
AI_SERVICE_URL=http://localhost:8000
PORT=8080

# Auth
JWT_SECRET=replace-me-with-openssl-rand-hex-32
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-me-with-openssl-rand-hex-32

# App
APP_NAME=BidFlow
ENVIRONMENT=development

# Optional: OAuth (leave blank to skip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Email (Resend)
RESEND_API_KEY=

# Optional: Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
