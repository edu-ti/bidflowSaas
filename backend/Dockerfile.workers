# ─────────────────────────────────────────────────────────
#  BidFlow Workers – Dockerfile
#  Produces: Asynq worker binary (separate entrypoint)
# ─────────────────────────────────────────────────────────
FROM golang:1.22-alpine AS builder
RUN apk add --no-cache git ca-certificates

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/workers ./workers/main.go

# ── Runtime ──────────────────────────────────────────────
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /bin/workers ./workers
CMD ["./workers"]
